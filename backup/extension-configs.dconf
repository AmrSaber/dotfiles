[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[auto-move-windows]
application-list=['com.vivaldi.Vivaldi.desktop:1', 'steam.desktop:3', 'com.mitchellh.ghostty.desktop:2']

[caffeine]
cli-toggle=true
enable-fullscreen=false
indicator-position=0
indicator-position-index=0
indicator-position-max=2
restore-state=true
show-indicator='always'
toggle-shortcut=['']
user-enabled=true

[dash-to-dock]
always-center-icons=true
animation-time=0.19999999999999968
apply-custom-theme=false
background-opacity=0.5
click-action='minimize-or-previews'
custom-background-color=false
custom-theme-shrink=true
dance-urgent-applications=false
dash-max-icon-size=48
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
hot-keys=false
icon-size-fixed=false
intellihide-mode='ALL_WINDOWS'
middle-click-action='launch'
multi-monitor=true
preferred-monitor=-2
preferred-monitor-by-connector='DP-5'
preview-size-scale=0.0
running-indicator-style='DEFAULT'
scroll-action='cycle-windows'
shift-click-action='minimize'
shift-middle-click-action='launch'
show-dock-urgent-notify=false
show-icons-emblems=true
show-mounts=false
show-trash=false
transparency-mode='FIXED'

[hidetopbar]
animation-time-autohide=0.0
animation-time-overview=0.0
enable-active-window=false
enable-intellihide=true
hot-corner=true
keep-round-corners=false
mouse-sensitive=true
mouse-sensitive-fullscreen-window=true
mouse-triggers-overview=false
pressure-threshold=0
pressure-timeout=0

[just-perfection]
animation=2
panel=true
panel-in-overview=true
panel-notification-icon=true
power-icon=true
startup-status=0
support-notifier-type=0
window-picker-icon=true
workspace-switcher-size=0

[nightthemeswitcher/time]
location=(51.518099999999997, -0.071418899999999993)
nightthemeswitcher-ondemand-keybinding=['']
sunrise=5.2432469109487059
sunset=20.98503463300294

[paperwm]
last-used-display-server='Wayland'
minimap-shade-opacity=159
open-window-position=0
restore-attach-modal-dialogs=''
restore-edge-tiling=''
restore-keybinds='{}'
restore-workspaces-only-on-primary=''
show-window-position-bar=false
show-workspace-indicator=true

[paperwm/workspaces]
list=['7b3127de-0095-46cc-a088-cf3a0eef6ff5', '63c23ff5-7cfb-4d4d-9b70-60dc211b30da', 'c9469b91-d238-4ecc-a62a-b545ee9a5b1a', '413bd39c-4096-40eb-b222-3ffbae895a7e', 'd594c04e-690c-44e6-8b4d-bb430485dcdb']

